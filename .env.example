# Copie para .env e ajuste os valores

# Reconhecimento facial
SIMILARITY_THRESHOLD=0.5
EMBEDDING_TTL_DAYS=90

# Supabase — nunca use a anon key no backend, sempre a service_role
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
SUPABASE_BUCKET_ORIGINALS=originals
SUPABASE_BUCKET_PREVIEWS=previews

# Banco de dados — connection string Postgres do Supabase
# Encontre em: Supabase Dashboard → Settings → Database → Connection string (URI)
# Substitua [PASSWORD] e [PROJECT-REF] pelos valores do seu projeto
DB_URL=postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# API
MAX_IMAGE_SIZE_MB=10.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ADMIN_TOKEN=troque-isso-em-producao

# Operação
DRY_RUN=false
