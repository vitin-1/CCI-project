# Copie para .env e ajuste os valores

# Reconhecimento facial
SIMILARITY_THRESHOLD=0.5
EMBEDDING_TTL_DAYS=90

# Storage (paths relativos à raiz do projeto)
STORAGE_ORIGINALS=storage/originals
STORAGE_PREVIEWS=storage/previews
FAISS_INDEX_PATH=storage/faiss.index

# Banco de dados
DB_URL=sqlite:///./storage/metadata.db

# API
MAX_IMAGE_SIZE_MB=10.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ADMIN_TOKEN=troque-isso-em-producao

# Operação
DRY_RUN=false
